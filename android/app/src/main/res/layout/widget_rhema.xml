<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Punchline du jour"
        android:textColor="#CAF000"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Une révélation chaque jour"
        android:textColor="#F3F3ED"
        android:textSize="16sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_ref"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#A9C400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="RHEMA"
        android:textColor="#77776F"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.22" />
</LinearLayout>
