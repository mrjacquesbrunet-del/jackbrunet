<div class="wrap collection">
  <h1>Recherche</h1>
  <form action="{{ routes.search_url }}" method="get" class="form-stack">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Chercher un produit…">
    <button type="submit" class="btn">Rechercher</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <div class="grid" style="margin-top:40px">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- else -%}
          <p class="muted">Aucun résultat pour « {{ search.terms | escape }} ».</p>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>
