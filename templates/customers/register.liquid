<div class="center-page">
  <h1>Créer un compte</h1>
  {%- form 'create_customer', class: 'form-stack' -%}
    <input type="text" name="customer[first_name]" placeholder="Prénom">
    <input type="email" name="customer[email]" placeholder="Email">
    <input type="password" name="customer[password]" placeholder="Mot de passe">
    <button type="submit" class="btn">Créer mon compte</button>
  {%- endform -%}
</div>
