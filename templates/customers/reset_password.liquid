<div class="center-page">
  <h1>Nouveau mot de passe</h1>
  {%- form 'reset_customer_password', class: 'form-stack' -%}
    <input type="password" name="customer[password]" placeholder="Nouveau mot de passe">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirme le mot de passe">
    <button type="submit" class="btn">Enregistrer</button>
  {%- endform -%}
</div>
