<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0A0B07">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;900&family=Playfair+Display:ital,wght@1,700;1,800&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <a class="skip" href="#main">Aller au contenu</a>

  {%- comment -%} Barre d'annonce lime {%- endcomment -%}
  <div class="annonce">PRÉCOMMANDE — SORTIE LE 7 SEPTEMBRE · OFFRE DE LANCEMENT</div>

  <header class="site-header">
    <a class="brand" href="{{ routes.root_url }}">JACK<strong>BRUNET</strong></a>
    <nav class="nav">
      <a href="{{ routes.all_products_collection_url }}">La boutique</a>
      <a href="https://jackbrunet.com/boutique/">Le livre</a>
      <a href="https://jackbrunet.com">Le site</a>
    </nav>
    <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Panier">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7h12l1 13H5zM9 7a3 3 0 0 1 6 0" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}
    </a>
  </header>

  <main id="main">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <p class="foot-brand">JACK<strong>BRUNET</strong></p>
    <p class="foot-note">RHEMA — 365 révélations bibliques · Préface de Josy W.Brunet</p>
    <nav class="foot-nav">
      <a href="https://jackbrunet.com">jackbrunet.com</a>
      <a href="https://jackbrunet.com/app/">L'application</a>
      <a href="{{ routes.cart_url }}">Panier</a>
    </nav>
    <p class="foot-legal">© {{ 'now' | date: '%Y' }} Jack Brunet. Tous droits réservés.</p>
  </footer>

  <script>
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var sel = '.card, .offer, .benefits li, .risk-grid > div, .faq details, .aa-col, ' +
        '.proof div, .proof-note, .p-demo-img, .p-h2, .p-lead, .mot img, .mot .quote, ' +
        '.store-badges a, .products .head, .p-final h2, .p-final-price';
      var els = document.querySelectorAll(sel);
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var el = e.target;
          el.classList.add('in');
          io.unobserve(el);
          setTimeout(function () {
            el.classList.remove('rv', 'in');
            el.style.transitionDelay = '';
          }, 900);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach(function (el, i) {
        el.classList.add('rv');
        el.style.transitionDelay = (i % 4) * 70 + 'ms';
        io.observe(el);
      });
      setTimeout(function () {
        document.querySelectorAll('.rv:not(.in)').forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('in');
        });
      }, 600);
    })();
  </script>
</body>
</html>
